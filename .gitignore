# ==============================================================================
# ZenLog Repository .gitignore
# Covers: Python (FastAPI), Flutter/Dart (Mobile/Android/iOS/Web), IDEs, OS, Secrets
# ==============================================================================

# ─── Secrets & Environment Variables ──────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*firebase*service*account*.json
firebase-adminsdk*.json
backend/firebase_service_account.json
backend/*.json.secret

# ─── Python & Virtual Environments ────────────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Python Scratch / Ad-hoc Test Scripts
scratch*.py
scratch/
test_*.local.py

# ─── Flutter & Dart ───────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/
**/coverage/
**/doc/api/
.widget_preview/

# Flutter Symbolication & Obfuscation
app.*.symbols
app.*.map.json
flutter_*.png

# ─── Android ──────────────────────────────────────────────────────────────────
**/android/.gradle/
**/android/local.properties
**/android/**/workspace.xml
**/android/**/tasks.xml
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/
*.keystore
*.jks
key.properties

# ─── iOS & macOS ──────────────────────────────────────────────────────────────
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM

# ─── IDE & Editors ────────────────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Sublime / Eclipse / Other
*.sublime-project
*.sublime-workspace
.project
.classpath
.cproject
.settings/

# ─── OS & Miscellaneous ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
pip-delete-this-directory.txt